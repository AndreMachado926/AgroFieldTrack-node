<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Admin Chats</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #000;
            color: #fff;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #111;
            display: flex;
            justify-content: flex-start;
            padding: 10px 20px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .navbar a {
            color: #fff;
            text-decoration: none;
            margin-right: 20px;
            font-weight: bold;
        }

        .navbar a:hover {
            color: #4A9782;
        }

        /* Conteúdo */
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 80px auto 50px auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .add-btn {
            background-color: #4A9782;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-bottom: 20px;
            font-size: 16px;
        }

        .add-btn:hover {
            background-color: #36735b;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th,
        td {
            padding: 12px 15px;
            border-bottom: 1px solid #444;
        }

        th {
            background-color: #222;
        }

        tr:hover {
            background-color: #333;
        }

        .action-btn {
            background-color: #dc3545;
            color: #fff;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            margin-right: 5px;
        }

        .edit-btn {
            background-color: #007bff;
        }

        .action-btn:hover {
            opacity: 0.8;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.8);
        }

        .modal-content {
            background-color: #111;
            margin: 10% auto;
            padding: 20px;
            border-radius: 10px;
            width: 500px;
            color: #fff;
            box-shadow: 0 0 10px #4A9782;
        }

        .modal-content h2 {
            text-align: center;
        }

        .modal-content input,
        .modal-content select,
        .modal-content textarea {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            border-radius: 5px;
            border: none;
            background-color: #222;
            color: #fff;
            box-sizing: border-box;
        }

        .modal-content textarea {
            resize: vertical;
            min-height: 80px;
        }

        .modal-content button {
            margin-top: 10px;
        }

        .close-btn {
            background-color: #dc3545;
            float: right;
            font-weight: bold;
            cursor: pointer;
        }

        .truncate {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <div class="navbar">
        <a href="/admin/users">Usuários</a>
        <a href="/admin/animais">Animais</a>
        <a href="/admin/plantacoes">Plantações</a>
        <a href="/admin/pastos">Pastos</a>
        <a href="/admin/chats">Chats</a>
    </div>

    <!-- Conteúdo principal -->
    <div class="container">
        <h1>Admin Chats</h1>
        <button class="add-btn" onclick="openAddModal()">Adicionar Chat</button>

        <!-- Tabela de chats -->
        <table>
            <thead>
                <tr>
                    <th>Tipo de Chat</th>
                    <th>Participantes</th>
                    <th>Mensagens</th>
                    <th>Criado em</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% chats.forEach(chat => { %>
                    <tr>
                        <td><%= chat.chatType || 'direto' %></td>
                        <td><%= chat.participantes ? chat.participantes.length : 0 %> pessoa(s)</td>
                        <td><%= chat.mensagens ? chat.mensagens.length : 0 %></td>
                        <td><%= new Date(chat.createdAt).toLocaleDateString('pt-PT') %></td>
                        <td>
                            <button class="action-btn edit-btn" onclick='openEditModal(<%= JSON.stringify(chat) %>)'>Editar</button>
                            <button class="action-btn" onclick="deleteChat('<%= chat._id %>')">Deletar</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Modal Único (Adicionar/Editar) -->
    <div id="chatModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal()">×</span>
            <h2 id="modalTitle">Adicionar Chat</h2>
            <form id="chatForm">
                <input type="hidden" name="id" id="chatId">
                <select name="chatType" required>
                    <option value="">Selecione Tipo de Chat</option>
                    <option value="direto">Direto</option>
                    <option value="grupo">Grupo</option>
                </select>
                <textarea name="participantes_ids" placeholder="IDs dos participantes (um por linha)" id="participantesField"></textarea>
                <button type="submit" class="add-btn">Adicionar</button>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById("chatModal");
        const form = document.getElementById("chatForm");
        const modalTitle = document.getElementById("modalTitle");
        const participantesField = document.getElementById("participantesField");

        function openAddModal() {
            modal.style.display = "block";
            form.reset();
            document.getElementById("chatId").value = "";
            form.querySelector("button[type=submit]").textContent = "Adicionar";
            modalTitle.textContent = "Adicionar Chat";
        }

        function openEditModal(chat) {
            modal.style.display = "block";
            document.getElementById("chatId").value = chat._id;
            form.chatType.value = chat.chatType || '';
            participantesField.value = (chat.participantes || []).join('\n');
            form.querySelector("button[type=submit]").textContent = "Salvar Alterações";
            modalTitle.textContent = "Editar Chat";
        }

        function closeModal() {
            modal.style.display = "none";
            form.reset();
            document.getElementById("chatId").value = "";
            form.querySelector("button[type=submit]").textContent = "Adicionar";
            modalTitle.textContent = "Adicionar Chat";
        }

        window.onclick = function (event) {
            if (event.target == modal) {
                closeModal();
            }
        }

        form.addEventListener("submit", async function (e) {
            e.preventDefault();
            const data = {
                id: document.getElementById("chatId").value,
                chatType: form.chatType.value,
                participantes: participantesField.value.split('\n').filter(p => p.trim())
            };

            let url = "/admin/chats/add";
            if (data.id) {
                url = "/admin/chats/edit";
            }

            fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        alert(data.id ? "Chat editado com sucesso!" : "Chat adicionado com sucesso!");
                        window.location.reload();
                    } else {
                        alert("Erro: " + result.message);
                    }
                })
                .catch(err => alert("Erro: " + err.message));
        });

        function deleteChat(chatId) {
            if (confirm("Tem certeza que deseja deletar este chat?")) {
                fetch(`/admin/chats/delete/${chatId}`, { method: "DELETE" })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert("Chat deletado com sucesso!");
                            window.location.reload();
                        } else {
                            alert("Erro ao deletar chat: " + data.message);
                        }
                    })
                    .catch(err => alert("Erro ao deletar chat: " + err.message));
            }
        }
    </script>

</body>

</html>
